{
  "__inputs": [
    {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {"type": "stat", "title": "Leaders", "id": 1, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(chronos_raft_leader)", "refId": "A"}], "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}},
    {"type": "stat", "title": "Applied Index", "id": 2, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(chronos_raft_applied_index)", "refId": "A"}], "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}},
    {"type": "timeseries", "title": "Ready Queue", "id": 3, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(chronos_queue_ready_tasks{namespace=\"_all\"})", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}},
    {"type": "timeseries", "title": "Pending Proposals", "id": 4, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "chronos_pending_proposals", "legendFormat": "{{instance}}", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}},
    {"type": "timeseries", "title": "Dispatch p95", "id": 5, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(chronos_dispatch_commit_seconds_bucket[5m])))", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"type": "timeseries", "title": "Retries", "id": 6, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(rate(chronos_task_retries_total[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"type": "timeseries", "title": "Worker Utilization", "id": 7, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max by (worker) (chronos_worker_utilization_ratio)", "legendFormat": "{{worker}}", "refId": "A"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"type": "timeseries", "title": "Raft Commits", "id": 8, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(rate(chronos_raft_commits_total[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16}},
    {"type": "timeseries", "title": "Committed Events", "id": 13, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(rate(chronos_raft_committed_events_total[5m]))", "refId": "A"}], "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16}},
    {"type": "timeseries", "title": "Elections", "id": 9, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(increase(chronos_raft_elections_total[1h]))", "refId": "A"}], "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16}},
    {"type": "timeseries", "title": "Snapshots", "id": 10, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max by (kind, result) (increase(chronos_snapshots_total[1h]))", "legendFormat": "{{kind}} {{result}}", "refId": "A"}], "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16}},
    {"type": "timeseries", "title": "Workflow Duration p95", "id": 11, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.95, max by (le, status) (rate(chronos_workflow_duration_seconds_bucket[5m])))", "legendFormat": "{{status}}", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}},
    {"type": "timeseries", "title": "Snapshot Duration p95", "id": 12, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.95, max by (le, kind) (rate(chronos_snapshot_seconds_bucket[5m])))", "legendFormat": "{{kind}}", "refId": "A"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}}
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["chronos"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Chronos Overview",
  "uid": "chronos-overview",
  "version": 2
}
